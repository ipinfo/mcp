# IPinfo API token
# Get a free token at https://ipinfo.io/signup
IPINFO_TOKEN=

# Base URL for the api.ipinfo.io endpoints (default: https://api.ipinfo.io)
# IPINFO_API_BASE_URL=https://api.ipinfo.io

# Base URL for the legacy ipinfo.io endpoints, e.g. /me (default: https://ipinfo.io)
# IPINFO_LEGACY_BASE_URL=https://ipinfo.io

# How long cached IP results stay fresh, in seconds (default: 3600)
# IPINFO_CACHE_TTL=3600

# OAuth issuer whose access tokens are accepted over HTTP. OAuth is off when unset.
# IPINFO_OAUTH_ISSUER=https://ipinfo.io

# Public URL of this server, required when IPINFO_OAUTH_ISSUER is set
# IPINFO_MCP_RESOURCE_URL=https://mcp.ipinfo.io/

# Where the issuer publishes its signing keys (default: <issuer>/.well-known/jwks.json)
# IPINFO_OAUTH_JWKS_URI=https://ipinfo.io/.well-known/jwks.json

# Ed25519 private key, PEM encoded, this server signs its AAuth agent tokens with. AAuth is off when unset.
# With it, people without an IPinfo account get Lite data through agents that sign their requests with AAuth
# and present a person token.
# Generate one with: openssl genpkey -algorithm ed25519
# IPINFO_AAUTH_PROVIDER_KEY=

# Public URL of this server for AAuth, required when IPINFO_AAUTH_PROVIDER_KEY is set.
# Its AAuth documents are served there, so it must be reachable from the internet.
# Person tokens must be issued for it, and IPINFO_MCP_RESOURCE_URL, when set, must have its scheme and host.
# IPINFO_AAUTH_ISSUER=https://mcp.ipinfo.io

# AAuth person servers whose person tokens are accepted, comma separated.
# Required when IPINFO_AAUTH_PROVIDER_KEY is set.
# IPINFO_AAUTH_PERSON_SERVERS=https://person.hello.coop
